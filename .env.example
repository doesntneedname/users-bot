# Токен бота Пачки (обязательно)
PACHCA_API_TOKEN=

# Signing secret из настроек бота → «Исходящий webhook».
# Пока пусто — подпись не проверяется, в лог пишется предупреждение.
PACHCA_WEBHOOK_SECRET=
# enforce — отбивать запросы с неверной подписью (401);
# log — только писать в лог результат сверки, ничего не блокируя
WEBHOOK_SIGNATURE_MODE=enforce

# Чат «Доступы»
ANNOUNCE_CHAT_ID=144223

# Кого считаем сотрудником: домены корпоративной почты через запятую
CORPORATE_DOMAINS=pachca.com

# Через сколько минут после приглашения объявлять нового сотрудника
INVITE_DELAY_MINUTES=120
# Сколько часов ждать заполнения карточки, прежде чем объявить как есть
INVITE_DEADLINE_HOURS=24
# Как часто воркер проверяет очередь
WORKER_INTERVAL_SECONDS=60
# Окно, в котором повторная доставка вебхука считается дублем
DEDUPE_TTL_HOURS=24

# 1 — ничего не постить в Пачку, только логировать
DRY_RUN=0
LOG_LEVEL=info
